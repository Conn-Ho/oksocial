# syntax=docker/dockerfile:1
FROM node:22.20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

# Dependencies first, from the lockfile alone: a commit that changes only code reuses this layer,
# and the pnpm store persists across builds in a cache mount (packages are copied out of it).
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc /app/
RUN --mount=type=cache,id=oksocial-pnpm-store,target=/root/.local/share/pnpm/store pnpm fetch

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN --mount=type=cache,id=oksocial-pnpm-store,target=/root/.local/share/pnpm/store pnpm install --offline --frozen-lockfile

# The version changes with every commit: declared here, it no longer invalidates the layers above.
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN --mount=type=cache,id=oksocial-next-cache,target=/app/apps/frontend/.next/cache \
    NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
