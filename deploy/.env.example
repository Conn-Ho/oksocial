# Copy to .env on the host (chmod 600). Never commit the real file.
OKSOCIAL_IMAGE=ghcr.io/conn-ho/oksocial:latest
MAIN_URL=https://oksocial.online
FRONTEND_URL=https://oksocial.online
NEXT_PUBLIC_BACKEND_URL=https://oksocial.online/api
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=
IS_GENERAL=true
DISABLE_REGISTRATION=false

# Email (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@oksocial.online
EMAIL_FROM_NAME=oksocial

# AI (OpenAI-compatible relay); OKSOCIAL_AI_MODEL is what inbox tagging / replies / translation use
OPENAI_API_KEY=
OPENAI_BASE_URL=
OKSOCIAL_AI_MODEL=

# Start the global loop workflows (missed posts, inbox sync)
RUN_CRON=true

# Payments
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
XORPAY_AID=
XORPAY_APP_SECRET=

# Browser channel: host worker (deploy/browser-fleet). Same token in /home/mac/oksocial/browser-worker.env
BROWSER_WORKER_URL=http://host.docker.internal:7788
BROWSER_WORKER_TOKEN=
# Official-API providers without credentials yet, hidden from "Add channel"
HIDDEN_PROVIDERS=

# okchat (customer service) handles the team's DMs: oksocial reads them in each account's browser,
# pushes them to okchat and sends okchat's replies. On only when both are set (secrets: never commit).
OKCHAT_URL=
OKCHAT_PARTNER_SECRET=
# extra hosts okchat's channel-bridge hooks may live on (comma separated) when not OKCHAT_URL's host or a subdomain
# OKCHAT_HOOK_HOSTS=
# okchat's OAuth callback(s), comma separated, for `okchat:oauth-app` (registers okchat as a first-party app)
OKCHAT_OAUTH_REDIRECT_URIS=https://okchat.online/omniauth/oksocial/callback

API_LIMIT=30
NX_ADD_PLUGINS=false
